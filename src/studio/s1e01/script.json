  },
  {
   "id": "d1",
   "char": "dad",
   "emo": "annoyed",
   "text": "Kimu? Why are you awake?",
   "t": 3.25
  },
  {
   "id": "k1",
   "char": "kimu",
   "emo": "scared",
   "text": "N-nothing. Just charging my phone.",
   "gap": 0.15
  },
  {
   "id": "d2",
   "char": "dad",
   "emo": "annoyed",
   "text": "Those wires again?",
   "gap": 0.25
  },
  {
   "id": "d3",
   "char": "dad",
   "emo": "angry",
   "text": "Study first. Then a job. Then the startup.",
   "gap": 0.15
  },
  {
   "id": "m1",
   "char": "mom",
   "emo": "worried",
   "text": "Please. He's tired.",
   "gap": 0.2
  },
  {
   "id": "d4",
   "char": "dad",
   "emo": "sad",
   "text": "I'm just afraid for you.",
   "gap": 0.2
  },
  {
   "id": "k2",
   "char": "kimu",
   "emo": "sad",
   "text": "I know, Dad. Sorry.",
   "gap": 0.2
  },
  {
   "id": "n2",
   "char": "narrator",
   "emo": "inner",
   "text": "Please. Show me where to start.",
   "t": 21.2
  },
  {
   "id": "n3",
   "char": "narrator",
   "emo": "inner",
   "text": "A bird on a wire. Thousands of volts. And it's fine.",
   "t": 28.3
  },
  {
   "id": "n4",
   "char": "narrator",
   "emo": "inner",
   "text": "Current flows only when there's a voltage difference.",
   "t": 32.8
  },
  {
   "id": "n5",
   "char": "narrator",
   "emo": "inner",
   "text": "One wire. Same voltage on both feet. No current.",
   "t": 37.4
  },
  {
   "id": "n6",
   "char": "narrator",
   "emo": "inner",
   "text": "Touch two wires, or the ground, and it's a different story.",
   "t": 41.7
  },
  {
   "id": "n7",
   "char": "narrator",
   "emo": "inner",
   "text": "Morning. Uncle's power keeps tripping.",
   "t": 46.4
  },
  {
   "id": "n8",
   "char": "narrator",
   "emo": "inner",
   "text": "Two bare wires touching. The one thing the bird avoids.",
   "t": 49.4
  },
  {
   "id": "u1",
   "char": "uncle",
   "emo": "joy",
   "text": "Well done, kid! You saved my evening.",
   "t": 54.9
  },
  {
