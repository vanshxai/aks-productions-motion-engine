 "lines": [
  {
   "id": "k0",
   "char": "kimu",
   "emo": "worried",
   "text": "No, no, no\u2014 not now.",
   "t": 1.0
  },
  {
   "id": "d1",
   "char": "dad",
   "emo": "stern",
   "text": "Kimu.",
   "t": 3.2
  },
  {
   "id": "k1",
   "char": "kimu",
   "emo": "scared",
   "text": "I\u2014 I'm just charging my phone.",
   "gap": 0.6
  },
  {
   "id": "d2",
   "char": "dad",
   "emo": "annoyed",
   "text": "Those wires. Again.",
   "gap": 0.35
  },
  {
   "id": "d3",
   "char": "dad",
   "emo": "angry",
   "text": "Focus on engineering. That's it.",
   "gap": 0.15
  },
  {
   "id": "m1",
   "char": "mom",
   "emo": "worried",
   "text": "Easy. He's tired.",
   "gap": 0.2
  },
  {
   "id": "d4",
   "char": "dad",
   "emo": "sad",
   "text": "Go to sleep, Kimu.",
   "gap": 0.35
  },
  {
   "id": "k2",
   "char": "kimu",
   "emo": "sad",
   "text": "Sorry, Dad.",
   "gap": 0.3
  },
  {
   "id": "n2",
   "char": "kimu",
   "emo": "whisper",
   "text": "Please... show me where to start.",
   "t": 21.2
  },
  {
   "id": "n3",
   "char": "narrator",
   "emo": "narrate",
   "text": "A bird on a wire. Thousands of volts... and it's fine.",
   "t": 28.3
  },
  {
   "id": "n4",
   "char": "narrator",
   "emo": "narrate",
   "text": "Like water, current only flows where there's a difference in level.",
   "t": 32.8
  },
  {
   "id": "n5",
   "char": "narrator",
   "emo": "narrate",
   "text": "One wire. Same voltage on both feet. No current.",
   "t": 37.4
  },
  {
   "id": "n6",
   "char": "narrator",
   "emo": "narrate",
   "text": "Touch a second wire, or the ground... and it's a different story.",
   "t": 41.7
  },
  {
   "id": "n7",
   "char": "narrator",
   "emo": "narrate",
   "text": "Next morning. Uncle's power keeps tripping.",
   "t": 46.1
  },
  {
   "id": "n8",
   "char": "narrator",
   "emo": "narrate",
   "text": "Two bare wires, touching. Exactly what the bird avoids.",
   "t": 49.4
  },
  {
   "id": "u1",
   "char": "uncle",
   "emo": "joy",
   "text": "Ha! Well done, kid. You saved my evening.",
   "t": 54.9
  },
  {
   "id": "n9",
   "char": "narrator",
   "emo": "narrate",
   "text": "Small proof. Big start.",
   "t": 57.55
  }
 ]
